# Copy to .env and adjust:   cp .env.example .env

# --- General -----------------------------------------------------------------
# "production" enforces a strong SECRET_KEY, DEBUG=false, and a non-default ADMIN_PASSWORD (the app refuses to start otherwise).
ENV=development
DEBUG=true

# --- Database ----------------------------------------------------------------
# docker compose overrides this to point at its own Postgres service.
# Local Postgres:  postgresql+psycopg2://telecom:telecom_pw@localhost:5432/telecom
# Zero-setup dev:  sqlite:///./telecom.db
DATABASE_URL=sqlite:///./telecom.db
POSTGRES_USER=telecom
POSTGRES_PASSWORD=telecom_pw
POSTGRES_DB=telecom

# --- Security ----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_super_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed browser origins (use explicit origins in production, not *)
CORS_ORIGINS=*

# Requests per client IP, e.g. 100/minute, 5/second, 1000/hour
RATE_LIMIT_DEFAULT=100/minute

# --- First Super Admin (created by `python -m scripts.seed`, which runs on container start) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# --- Container ---------------------------------------------------------------
API_PORT=8000
RUN_MIGRATIONS=true
# WEB_CONCURRENCY=2
